# Copy to .env, or better: run `python scripts/generate_env.py` to create .env with random secrets.
# .env is git-ignored and docker-ignored. NEVER commit it.
# Values marked "generate-me" are rejected at startup if left as placeholders.
# (Comments are on their own lines on purpose: Compose and python-dotenv treat inline "#" differently.)

# development | test | production
APP_ENV=production
APP_NAME=AppFactory AI
# Host port for the API; bound to 127.0.0.1 only.
API_PORT=8000

# --- API authentication (send as header X-API-Key) ---
# Named reviewers (recommended): the key's name is recorded as the reviewer in the approval audit trail.
# Format name:key,name2:key2 - each key at least 24 characters.
API_KEYS=generate-me
# Alternative single key (reviewer name "owner"). Leave empty when using API_KEYS.
API_KEY=

# --- Data store passwords (docker-compose builds DATABASE_URL / REDIS_URL from these) ---
# URL-safe characters only (hex / base64url); the generator does this for you.
POSTGRES_PASSWORD=generate-me
REDIS_PASSWORD=generate-me

# --- Providers (required for real research runs) ---
ANTHROPIC_API_KEY=
# CrewAI model id: "anthropic/<model>". Confirm availability on your account with:
#   docker compose run --rm api python -m scripts.check_integrations
CLAUDE_MODEL=anthropic/claude-sonnet-5-5
TAVILY_API_KEY=
# basic = 1 Tavily credit per search, advanced = 2
TAVILY_SEARCH_DEPTH=advanced

# --- Research controls ---
MAX_SEARCH_RESULTS=8
MAX_OPPORTUNITIES=10
# Hard cap on search/lookup calls per run (cost control).
MAX_TOOL_CALLS_PER_RUN=60
# Queued + running runs allowed at once; further submissions get HTTP 429.
MAX_ACTIVE_RUNS=3
# Per-agent reasoning/tool iterations and wall-clock seconds.
RESEARCH_MAX_ITERATIONS=10
RESEARCH_MAX_EXECUTION_SECONDS=900
RECOMMEND_THRESHOLD=70
# Separate gate for the games domain (same default; tune after real games runs)
RECOMMEND_THRESHOLD_GAMES=70

# --- Worker ---
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=2700
LEASE_SECONDS=300
# Claims per run; only grows if a worker dies mid-run.
MAX_ATTEMPTS=2
